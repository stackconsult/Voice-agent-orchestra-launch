# AI-OS Environment Configuration
# Copy this file to .env and update with your actual values

# Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Cloud AI Configuration (Optional)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI Configuration (if using OpenAI)
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Configuration (if using Anthropic)
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Gemini Configuration (if using Gemini)
GEMINI_MODEL=gemini-pro

# Audio/Transcription Configuration
WHISPER_CPP_PATH=/usr/local/bin/whisper.cpp
AUDIO_DEVICE=default

# System Configuration
AIOS_HOME=/Users/kirtissiemens/.aios
SKILLS_DIR=./skills
LOGS_DIR=/Users/kirtissiemens/.aios/logs
SNAPSHOTS_DIR=/Users/kirtissiemens/.aios/snapshots

# Execution Configuration
DEFAULT_TIMEOUT=30
MAX_EXECUTION_TIME=300
SAFE_MODE=true

# Cost Configuration
COST_BUDGET=10.0
FALLBACK_THRESHOLD=0.7

# Monitoring Configuration
MONITORING_ENABLED=true
RESOURCE_CHECK_INTERVAL=5.0

# Voice Configuration
HOTKEY_ENABLED=true
HOTKEY_MODIFIERS=["cmd", "shift"]
HOTKEY_KEY="v"
GLOBAL_HOTKEY=true

# Development Configuration
DEBUG=false
LOG_LEVEL=INFO
